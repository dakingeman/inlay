<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. Settings are backed up and moved to a new phone; copied text and learned words never leave this device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="clipboard.json" />
        <exclude domain="file" path="my_words.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="clipboard.json" />
        <exclude domain="file" path="my_words.json" />
    </device-transfer>
</data-extraction-rules>
